{
    "name": "freightline-frontend",
    "version": "0.1.0",
    "description": "Domain-neutral Next.js App Router starter with token-driven design system.",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3100",
        "build": "next build",
        "start": "next start -p 3100",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "codemod:extract-hooks": "jiti tools/codemods/run-extract-transport-to-hook.ts",
        "contract": "jiti tools/contract/run-generate-contract.ts",
        "contract:check": "jiti tools/contract/run-generate-contract.ts --check",
        "lint": "eslint",
        "prepare": "git config --unset-all core.hooksPath || exit 0"
    },
    "dependencies": {
        "@carbon/icons-react": "^11.87.0",
        "@deck.gl/core": "^9.4.0",
        "@deck.gl/geo-layers": "^9.4.0",
        "@deck.gl/layers": "^9.4.0",
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.18.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "jose": "^6.2.12",
        "motion": "^12.42.2",
        "nanoid": "^6.0.1",
        "next": "16.2.10",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "server-only": "^0.0.1",
        "topojson-client": "^3.1.0",
        "us-atlas": "^3.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/topojson-client": "^3.1.5",
        "@types/topojson-specification": "^1.0.5",
        "@typescript-eslint/rule-tester": "^8.66.0",
        "@typescript-eslint/utils": "^8.66.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "fast-check": "^4.9.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4",
        "ts-morph": "^28.0.0",
        "typescript": "^5",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    }
}
